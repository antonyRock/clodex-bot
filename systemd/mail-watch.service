[Unit]
Description=Mail watcher: important emails to Telegram
[Service]
Type=oneshot
WorkingDirectory=/root/tg-bot
EnvironmentFile=/root/.config/mail.env
EnvironmentFile=/root/.config/tg-bot.env
EnvironmentFile=/root/.config/claude-token
Environment=TG_ALLOWED=__TG_ID__
Environment=HOME=/root
ExecStart=/usr/bin/python3 /root/tg-bot/mail_watch.py
TimeoutStartSec=600
