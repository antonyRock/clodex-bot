[Unit]
Description=Telegram bot of cloud agent (Claude without Bash)
After=network-online.target
Wants=network-online.target
[Service]
WorkingDirectory=/root/tg-bot
EnvironmentFile=/root/.config/tg-bot.env
EnvironmentFile=/root/.config/claude-token
EnvironmentFile=/root/.config/mail.env
Environment=TG_ALLOWED=__TG_ID__
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/root/tg-bot/venv/bin/python /root/tg-bot/bot.py
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
