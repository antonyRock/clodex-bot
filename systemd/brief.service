[Unit]
Description=Morning brief to Telegram (tasks, meetings, mail, systems)
OnFailure=guard-daily.service
[Service]
Type=oneshot
WorkingDirectory=/root/tg-bot
EnvironmentFile=/root/.config/mail.env
EnvironmentFile=/root/.config/tg-bot.env
EnvironmentFile=/root/.config/claude-token
Environment=TG_ALLOWED=__TG_ID__
Environment=HOME=/root
ExecStart=/usr/bin/python3 /root/tg-bot/brief.py
TimeoutStartSec=900
