[Unit]
Description=Question of the day to Telegram (one open task of the owner)
[Service]
Type=oneshot
WorkingDirectory=/root/tg-bot
EnvironmentFile=/root/.config/mail.env
EnvironmentFile=/root/.config/tg-bot.env
Environment=TG_ALLOWED=__TG_ID__
Environment=HOME=/root
ExecStart=/usr/bin/python3 /root/tg-bot/nudge.py
TimeoutStartSec=120
